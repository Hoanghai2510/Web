PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# BẮT BUỘC đặt chuỗi ngẫu nhiên dài trước khi deploy production (vd: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_TTL=8h
DATABASE_PATH=./data/portal.db
LOGIN_RATE_LIMIT=12
# Mở khóa tài khoản demo khi NODE_ENV=production (không khuyến nghị):
# ALLOW_DEMO=1
# Thông tin cổng thanh toán cố ý không có ở đây. Chỉ bổ sung sau khi chọn nhà cung cấp.